# Production / Docker: the backend connects over the internal Docker network.
DATABASE_URL=postgresql://postgres:postgres@archschool_db:5432/archschool_db

# Local development without Docker:
# DATABASE_URL=sqlite:///./homework.db

# JSON array parsed by pydantic-settings. Must include every origin the
# browser uses (scheme + host + port, no trailing slash).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://archschool.vidxsepehr.ir","http://archschool.vidxsepehr.ir"]

# Maximum upload size in megabytes. Keep the Nginx client_max_body_size
# (host + container) a little higher to allow for multipart overhead.
MAX_UPLOAD_MB=25

# Anti-cheat / streak behaviour (defaults match the product requirements).
COMPLETION_DELAY_MINUTES=30
TOGGLE_LIMIT_PER_HOUR=3
TOGGLE_LOCK_MINUTES=60
# School wall clock for streak days and 7-day activity buckets (Iran = UTC+3:30).
SCHOOL_UTC_OFFSET_HOURS=3.5

# ---------------------------------------------------------------------------
# Mobile push notifications (Expo)
# ---------------------------------------------------------------------------
# The backend sends through https://exp.host; the mobile app registers its
# token at POST /api/users/push-token. Set to false to silence every push and
# stop the deadline watcher without redeploying the mobile app.
PUSH_NOTIFICATIONS_ENABLED=true
# How often the in-process watcher checks for assignments entering the
# 24-hour / 2-hour windows. No Celery/Redis worker is involved.
DEADLINE_CHECK_INTERVAL_MINUTES=10
# Only needed if the Expo project enables "enhanced push security": every
# request to exp.host then needs `Authorization: Bearer <token>`. Leave empty
# for the default public endpoint.
EXPO_ACCESS_TOKEN=

# Replace with a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Must be exactly 6 characters: uppercase English letters and numbers.
# Change this before exposing the application.
ADMIN_CODE=ROOT01
