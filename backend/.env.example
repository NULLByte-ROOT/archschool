# Production / Docker: the backend connects over the internal Docker network.
DATABASE_URL=postgresql://postgres:postgres@archschool_db:5432/archschool_db

# Local development without Docker:
# DATABASE_URL=sqlite:///./homework.db

# JSON array parsed by pydantic-settings. Must include every origin the
# browser uses (scheme + host + port, no trailing slash).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://archschool.vidxsepehr.ir","http://archschool.vidxsepehr.ir"]

# Maximum upload size in megabytes. Keep the Nginx client_max_body_size
# (host + container) a little higher to allow for multipart overhead.
MAX_UPLOAD_MB=25

# Replace with a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Change this before exposing the application.
ADMIN_CODE=change-me
