# Production / Docker: the backend connects over the internal Docker network.
DATABASE_URL=postgresql://postgres:postgres@archschool_db:5432/archschool_db

# Local development without Docker:
# DATABASE_URL=sqlite:///./homework.db

# JSON array parsed by pydantic-settings
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Replace with a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Change this before exposing the application.
ADMIN_CODE=change-me
