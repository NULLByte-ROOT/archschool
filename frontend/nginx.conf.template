# Rendered by the nginx image entrypoint at container start
# (/etc/nginx/templates -> /etc/nginx/conf.d). Only BACKEND_* variables are
# substituted (NGINX_ENVSUBST_FILTER), so nginx's own $host / $uri / $scheme
# are left untouched.
#
# BACKEND_HOST is set per blue/green slot in docker-compose.yml, which is what
# lets two isolated slots serve the same application image.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Backend enforces 25 MB (MAX_UPLOAD_MB). Nginx is set slightly higher so
    # the multipart overhead (boundaries + headers) never trips the limit.
    client_max_body_size 30m;
    client_body_timeout 300s;

    # Container healthcheck. Deliberately proves only that this nginx worker
    # is serving; the deploy script performs the end-to-end frontend -> backend
    # check separately.
    location = /healthz {
        access_log off;
        default_type text/plain;
        add_header Cache-Control "no-store";
        return 200 "ok\n";
    }

    # Git SHA of the image, written at build time. Used by deploy.sh to verify
    # that traffic was really switched to the new slot.
    location = /version {
        default_type text/plain;
        add_header Cache-Control "no-store";
        try_files /version =404;
    }

    # WebSocket endpoint (chat) — needs the upgrade headers.
    #
    # `^~` is essential: a regex location (e.g. a static-asset rule) would
    # otherwise win and serve /api/ws as a file, which reaches FastAPI as a
    # plain HTTP GET and is answered with 404 — and the browser then reports a
    # bare 1006 with no clue why.
    location ^~ /api/ws {
        proxy_pass http://${BACKEND_HOST}:8000/api/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Forward the *public* host, not the Docker container name, so FastAPI
        # and any absolute URL it builds point at archschool.vidxsepehr.ir.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Streaming, not buffering: a buffered upgrade never completes and
        # shows up as an idle/abnormal close.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # REST API + uploaded media (/api/media/...).
    # `^~` stops any regex location (e.g. a host-level `\.(jpg|png)$` static
    # cache rule) from hijacking image requests away from the backend.
    # /api/ also contains /api/ws, but nginx always picks the longest matching
    # prefix, so this never shadows the WebSocket block above.
    location ^~ /api/ {
        proxy_pass http://${BACKEND_HOST}:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
